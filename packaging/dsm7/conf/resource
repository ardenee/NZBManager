{
  "webservice": {
    "services": [
      {
        "service": "nzbmanager",
        "display_name": "NZB Manager",
        "support_alias": true,
        "support_server": false,
        "type": "nginx_php",
        "root": "nzbmanager/public",
        "index": [
          "index.php"
        ],
        "icon": "ui/nzb_{0}.png",
        "php": {
          "profile_name": "NZB Manager PHP 8.2",
          "profile_desc": "Package PHP 8.2 profile for NZB Manager",
          "backend": 11,
          "open_basedir": "/var/services/web_packages/nzbmanager:/var/packages/nzbmanager/var:/volume1:/volume2:/volume3:/volume4:/etc.defaults:/tmp:/var/services/tmp",
          "extensions": [
            "curl",
            "mbstring"
          ],
          "user": "nzbmanager",
          "group": "http"
        },
        "connect_timeout": 30,
        "read_timeout": 120,
        "send_timeout": 30
      }
    ],
    "portals": [
      {
        "service": "nzbmanager",
        "name": "nzbmanager",
        "display_name": "NZB Manager",
        "type": "alias",
        "alias": "nzbmanager"
      }
    ],
    "pkg_dir_prepare": [
      {
        "source": "/var/packages/nzbmanager/target/webapp",
        "target": "nzbmanager",
        "mode": "0755",
        "user": "nzbmanager",
        "group": "http"
      }
    ]
  }
}
